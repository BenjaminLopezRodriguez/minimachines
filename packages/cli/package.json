{
  "name": "@minimachines/cli",
  "version": "0.2.1",
  "description": "CLI to attach to minimachin.es machine sessions",
  "type": "module",
  "bin": {
    "minimachines": "dist/cli.js",
    "mm": "dist/cli.js",
    "cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.mkdirSync('skill',{recursive:true});fs.copyFileSync('../../public/skills/minimachine/SKILL.md','skill/SKILL.md')\" && tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "cross-spawn": "7.0.6",
    "ink": "7.1.1",
    "open": "^10.1.0",
    "react": "19.2.0",
    "y-partyserver": "2.2.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^20.14.10",
    "@types/react": "19.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "minimachines",
    "minimachine",
    "cli",
    "agents",
    "vm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenjaminLopezRodriguez/minimachines.git",
    "directory": "packages/cli"
  }
}
